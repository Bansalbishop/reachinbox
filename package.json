{
  "name": "outbox",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "build": "prisma generate && tsc",
    "typecheck": "tsc --noEmit",
    "db:start": "powershell -ExecutionPolicy Bypass -File scripts/start-db.ps1",
    "db:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-db.ps1",
    "redis:start": "powershell -ExecutionPolicy Bypass -File scripts/start-redis.ps1",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "es:setup": "tsx scripts/es-setup.ts",
    "es:reconcile": "tsx scripts/es-reconcile.ts"
  },
  "dependencies": {
    "@bull-board/api": "^6.5.0",
    "@bull-board/express": "^6.5.0",
    "@elastic/elasticsearch": "^8.17.0",
    "@prisma/client": "^6.5.0",
    "@slack/web-api": "^7.9.0",
    "bullmq": "^5.40.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "google-auth-library": "^9.15.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "nodemailer": "^6.9.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
